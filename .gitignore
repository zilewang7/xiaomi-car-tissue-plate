# Local only: the phone numbers and texts (config.toml, the web UI's backups and half-written files)
config*.toml*
!config.example.toml
# Build outputs, the venv, the font (MiSans may not be redistributed on its own)
out/
.venv/
fonts/
*.ttf
# Part and print files copied out of out/ carry the numbers and texts
*.3mf
*.stl
*.step
*.gcode
*.zip
# Editor and OS leftovers
*~
.*.sw?
\#*#
__pycache__/
.DS_Store
# The author's test prints
docs/test-results/
